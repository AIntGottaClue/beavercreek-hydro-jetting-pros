---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Callout from '../../components/Callout.astro';
import { services, guides } from '../../data/pages';
import { neighborhoods } from '../../data/neighborhoods';
import { u } from '../../lib/utils';
const title = 'Hydro Jetting Guides in Beavercreek, OH';
const description = 'Plain guides on how hydro jetting works and how it compares with snaking for drain and sewer lines in Beavercreek, Ohio.';
---
<Base title={title} description={description} path="/guides/" crumbs={[{ name: 'Guides', path: '/guides/' }]}>
  <Hero headline="Hydro Jetting Guides in Beavercreek, OH" intro="Short guides to help you ask the right questions before any drain cleaning." location="Guides" crumbs={[{ href: '/guides/', label: 'Guides' }]} />
  <section class="sec sec-cream"><div class="sec-in">
    <div class="svc-grid">{guides.map((g) => <a class="svc" href={u(`/guides/${g.slug}/`)}><span class="eb">Guide</span><h3>{g.name}</h3><p>{g.blurb}</p><span class="arrow">Read more &rarr;</span></a>)}</div>
  </div></section>
  <Callout />
</Base>
